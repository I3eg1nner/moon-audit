// ── P1a simplified instrumentation: runtime package + function report ─────
// No source rewriting — generates a standalone runtime package and a JSON
// function report that users can use to add record() calls manually.

///|
pub(all) struct InstrumentReport {
  fn_name : String
  file : String
  line : Int
  pkg_dir : String
}

///|
pub fn generate_instrument_report(
  root : String,
  config : Config,
) -> Array[InstrumentReport] {
  let world = load_program_world(root, config)
  let report : Array[InstrumentReport] = []
  for pkg in world.packages {
    for file in pkg.files {
      let source = @fs.read_file_to_string(file) catch { _ => continue }
      let (impls, _) = @parser.parse_string(source, name=file)
      for item in impls {
        match item {
          TopFuncDef(fun_decl~, ..) => {
            let name = fun_decl.name.name
            let qual = match fun_decl.type_name {
              Some(tn) => type_name_str_pub(tn) + "::" + name
              None => name
            }
            report.push({
              fn_name: qual,
              file: file.replace(old=root + "/", new=""),
              line: fun_decl.loc.start.lnum,
              pkg_dir: pkg.dir.replace(old=root + "/", new=""),
            })
          }
          TopImpl(method_name~, ..) =>
            report.push({
              fn_name: method_name.name,
              file: file.replace(old=root + "/", new=""),
              line: method_name.loc.start.lnum,
              pkg_dir: pkg.dir.replace(old=root + "/", new=""),
            })
          _ => ()
        }
      }
    }
  }
  report
}

///|
fn type_name_str_pub(tn : @syntax.TypeName) -> String {
  match tn.name {
    Ident(name~) => name
    Dot(pkg~, id~) => pkg + "::" + id
  }
}

///|
pub fn write_runtime_package(output_dir : String) -> Unit {
  // create output dirs (non-recursive is fine: two levels)
  @fs.create_dir(output_dir) catch {
    _ => ()
  }
  @fs.create_dir(output_dir + "/src") catch {
    _ => ()
  }
  // moon.mod
  @fs.write_string_to_file(
    output_dir + "/moon.mod",
    "name = \"moon-audit-instrument\"\nversion = \"0.1.0\"\n",
  ) catch {
    _ => ()
  }
  // src/moon.pkg
  @fs.write_string_to_file(
    output_dir + "/src/moon.pkg",
    "pkgtype(kind: \"executable\")",
  ) catch {
    _ => ()
  }
  // src/runtime.mbt — the instrument runtime
  @fs.write_string_to_file(
    output_dir + "/src/runtime.mbt",
    "// generated by moon-audit instrument (P1a simplified)\n" +
    "let recorded : Array[String] = []\n" +
    "pub fn record(edge : String) -> Unit { recorded.push(edge) }\n" +
    "pub fn dump() -> String {\n" +
    "  recorded.join(\"\\n\")\n" +
    "}\n",
  ) catch {
    _ => ()
  }
  // src/main.mbt — entry point that dumps
  @fs.write_string_to_file(
    output_dir + "/src/main.mbt",
    "fn main {\n" + "  println(dump())\n" + "}\n",
  ) catch {
    _ => ()
  }
}

///|
pub fn format_instrument_report_json(
  report : Array[InstrumentReport],
) -> String {
  let buf = StringBuilder()
  buf.write_string("{\n")
  buf.write_string("  \"functions\": [\n")
  let mut i = 0
  for entry in report {
    buf.write_string("    {")
    buf.write_string("\"fn\": \"" + entry.fn_name + "\", ")
    buf.write_string("\"file\": \"" + entry.file + "\", ")
    buf.write_string("\"line\": " + entry.line.to_string() + ", ")
    buf.write_string("\"pkg\": \"" + entry.pkg_dir + "\"")
    buf.write_string("}")
    i += 1
    if i < report.length() {
      buf.write_string(",")
    }
    buf.write_string("\n")
  }
  buf.write_string("  ],\n")
  buf.write_string("  \"total\": " + report.length().to_string() + ",\n")
  buf.write_string(
    "  \"note\": \"add @runtime.record(fn_name) at each function entry; run with dump() at exit; compare with moon-audit call-graph\"\n",
  )
  buf.write_string("}\n")
  buf.to_string()
}
